---
import PhotoGallery from "../components/PhotoGallery.astro"
import Global from "./Global.astro"
import type { MDWorkProps } from "../types/types"

interface Props {
	frontmatter: MDWorkProps
}
const { frontmatter } = Astro.props
const { gallery, wistiaId, qqVideoId, vimeoId } = frontmatter
---

<Global pageTitle={frontmatter.title}>
	{
		gallery && (
			<section class="work-gallery">
				<PhotoGallery title={frontmatter.title} pictures={gallery} />
			</section>
		)
	}
	{
		wistiaId &&
			wistiaId.map((videoId) => (
				<section>
					<div
						class={`wistia_embed wistia_async_${videoId}`}
						style="height:360px;width:640px"
					>
						&nbsp;
					</div>
				</section>
			))
	}
	{
		qqVideoId &&
			qqVideoId.map((videoId) => (
				<iframe
					src={`https://v.qq.com/txp/iframe/player.html?vid=${videoId}`}
					allow={"autoplay; fullscreen"}
					allowfullscreen={true}
				/>
			))
	}
	{
		vimeoId &&
			vimeoId.map((videoId) => (
				<iframe
					src={`https://player.vimeo.com/video/${videoId}`}
					allow={"autoplay; fullscreen"}
					allowfullscreen={true}
				/>
			))
	}
	<section class="main">
		<h2>{frontmatter.title}</h2>
		<div class="work-description">
			{frontmatter.description}
		</div>
		<div class="work-content">
			<slot />
		</div>
	</section>
</Global>

{
	wistiaId && (
		<script
			charset="ISO-8859-1"
			src="//fast.wistia.com/assets/external/E-v1.js"
			async
		/>
	)
}
