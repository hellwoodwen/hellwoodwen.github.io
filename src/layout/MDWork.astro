---
import PhotoGallery from "../components/PhotoGallery.astro";
import Global from "./Global.astro";

interface Props {
  frontmatter: {
    title: string;
    year: number;
    description: string;
    image: {
      url: string;
      alt: string;
    };
    category: string;
    order: number;
    gallery: string[];
  };
}
const { frontmatter } = Astro.props;
const { gallery } = frontmatter;
---

<Global pageTitle={frontmatter.title}>
  <section class="work-gallery">
    <PhotoGallery title={frontmatter.title} pictures={gallery} />
  </section>
  <section class="main">
    <h2>{frontmatter.title}</h2>
    <div class="work-description">
      {frontmatter.description}
    </div>
    <div class="work-content">
      <slot />
    </div>
  </section>
</Global>