---
import type { MarkdownInstance } from "astro"
import Global from "./Global.astro"
import type { MDWorkProps } from "../types/types"

interface Props {
	worksList: MarkdownInstance<MDWorkProps>[]
}

const { worksList } = Astro.props
---

<Global pageTitle="works">
	<div class="works-gallery">
		{
			worksList
				.sort((a, b) => a.frontmatter.order - b.frontmatter.order)
				.map((work) => {
					const { image, title } = work.frontmatter
					return (
						<div class="works-gallery__work">
							<a href={work.url}>
								<div class="works-gallery__work__th">
									<img src={image} alt={title} />
								</div>
								<div class="works-gallery__work__title">{title}</div>
							</a>
						</div>
					)
				})
		}
	</div>
</Global>

<style lang="less">
	.works-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		grid-gap: 50px 40px;
		margin-bottom: 4rem;
		padding: 3rem 1rem 0;

		&__work {
			&__th {
				padding-bottom: 0.5rem;
			}
			a {
				text-decoration: none;
				color: black;
				font-weight: bold;
			}
		}
	}
	@media (min-width: 992px) {
		.works-gallery {
			padding-right: 3rem;
		}
	}
</style>
