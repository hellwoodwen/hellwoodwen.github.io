---
import Works from '../layout/Works.astro'
const allWorks = await Astro.glob("../pages/works/*.md")
---

<Works>
	Index
	<div class="works-gallery">
		{
			allWorks.map((work) => {
				const { image, title } = work.frontmatter
				return (
					<div class="works-gallery__work">
						<a href={work.url}>
							<div class="works-gallery__work__th">
								<img src={image.url} alt={image.alt} />
							</div>
							<div class="works-gallery__work__title">{title}</div>
						</a>
					</div>
				)
			})
		}
	</div>
</Works>